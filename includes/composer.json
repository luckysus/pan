{
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "7.17.0",
        "guzzlehttp/guzzle-services": "1.7.6",
        "guzzlehttp/command": "1.5.4",
        "guzzlehttp/psr7": "2.13.6",
        "guzzlehttp/promises": "2.6.2",
        "psr/http-message": "1.1",
        "myclabs/php-enum": "1.6.6",
        "symfony/polyfill-intl-idn": "^1.43",
        "symfony/polyfill-intl-normalizer": "1.26.0",
        "symfony/polyfill-php72": "1.26.0"
    },
    "autoload": {
        "files": [
            "lib/HttpCompat.php"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "optimize-autoloader": true,
        "allow-plugins": false
    }
}
